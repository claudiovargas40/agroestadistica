\name{melon_crecimiento}
\alias{melon_crecimiento}
\docType{data}
\encoding{UTF-8}
\title{Crecimiento del melón en cuatro fechas}
\description{Largo de la guía y número de hojas de 201 plantas de melón medidas en cuatro fechas, del 10 de marzo al 6 de abril de 2021.}
\usage{melon_crecimiento}
\format{Un marco de datos con 804 filas y 5 variables:
\describe{
  \item{\code{planta_id}}{Identificador de la planta (P001 a P201)}
  \item{\code{dosis_biol_pct}}{Concentración del biol (\%)}
  \item{\code{fecha}}{Fecha de medición}
  \item{\code{largo_guia_cm}}{Longitud de la guía principal (cm)}
  \item{\code{n_hojas}}{Número de hojas (hojas)}
}}
\source{Vargas-Vargas, M. C. (2022). \emph{Efecto de la aplicación de diferentes dosis de biol sobre características agronómicas y la supresión de mildiú velloso (Pseudoperonospora cubensis Berk. et Curt. Rost.) en el cultivo de melón (Cucumis melo) en Guanacaste} [Tesis de licenciatura, Universidad de Costa Rica, Sede de Guanacaste]. \url{https://repositorio.sibdi.ucr.ac.cr/items/86dbfcc7-a773-47c0-855d-c527cba62b70}. Usado con autorización y depurado con fines didácticos.}
